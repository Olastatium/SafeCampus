<?xml version="1.0" encoding="UTF-8" ?>
<ContentView x:Class="SafeCampus.Controls.InputField"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:SafeCampus.Controls">
    <VerticalStackLayout Spacing="6">
        <Label x:Name="CaptionLabel" Style="{StaticResource Caption}" />
        <Border Style="{StaticResource InputBorder}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Entry x:Name="Field"
                       FontSize="15"
                       TextColor="{StaticResource SlateDark}"
                       PlaceholderColor="{StaticResource CheckGrey}"
                       BackgroundColor="Transparent"
                       VerticalOptions="Center" />
                <controls:IconView x:Name="EyeIcon"
                                   Grid.Column="1"
                                   Kind="eye"
                                   Size="22"
                                   IconColor="{StaticResource Slate}"
                                   IsVisible="False">
                    <controls:IconView.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnEyeTapped" />
                    </controls:IconView.GestureRecognizers>
                </controls:IconView>
            </Grid>
        </Border>
    </VerticalStackLayout>
</ContentView>
