<?xml version="1.0" encoding="UTF-8" ?>
<Shell x:Class="SafeCampus.AppShell"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:SafeCampus.Views"
       FlyoutBehavior="Disabled"
       Shell.NavBarIsVisible="False"
       Shell.TabBarIsVisible="False">

    <!-- 01 Connexion -->
    <ShellContent Route="login" ContentTemplate="{DataTemplate views:LoginPage}" />
    <!-- 02 Inscription -->
    <ShellContent Route="register" ContentTemplate="{DataTemplate views:RegisterPage}" />
    <!-- 03 Accueil -->
    <ShellContent Route="home" ContentTemplate="{DataTemplate views:HomePage}" />
    <!-- 07 Zones du campus (onglet Carte) -->
    <ShellContent Route="map" ContentTemplate="{DataTemplate views:ZonesPage}" />
    <!-- 05 Géolocalisation (Ma position) -->
    <ShellContent Route="position" ContentTemplate="{DataTemplate views:PositionPage}" />
    <!-- 04 Signaler un incident -->
    <ShellContent Route="report" ContentTemplate="{DataTemplate views:ReportPage}" />
    <!-- 08 Suivi du signalement (onglet Signalements) -->
    <ShellContent Route="tracking" ContentTemplate="{DataTemplate views:TrackingPage}" />
    <!-- 06 Contacts sécurité -->
    <ShellContent Route="contacts" ContentTemplate="{DataTemplate views:ContactsPage}" />
    <!-- Alerte rapide : confirmation -->
    <ShellContent Route="confirmation" ContentTemplate="{DataTemplate views:AlertConfirmationPage}" />
    <!-- Profil -->
    <ShellContent Route="profile" ContentTemplate="{DataTemplate views:ProfilePage}" />

</Shell>
