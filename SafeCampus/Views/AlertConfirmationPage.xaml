<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="SafeCampus.Views.AlertConfirmationPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:SafeCampus.Controls"
             Title="Confirmation de l’alerte">

    <Grid RowDefinitions="Auto,*">

        <controls:PageHeader Title="Alerte rapide" ShowBack="True" ShowBell="False"
                             BackRoute="//home" Padding="0,10,0,14" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="22,40,22,24" Spacing="0" HorizontalOptions="Fill">

                <Border WidthRequest="120" HeightRequest="120" BackgroundColor="{StaticResource RedLight}"
                        StrokeThickness="0" StrokeShape="RoundRectangle 60" HorizontalOptions="Center">
                    <Border WidthRequest="76" HeightRequest="76" BackgroundColor="{StaticResource Red}"
                            StrokeThickness="0" StrokeShape="RoundRectangle 38">
                        <controls:IconView Kind="alert" Size="36" IconColor="White" />
                    </Border>
                </Border>

                <Label Text="Confirmer l’envoi de l’alerte ?" Style="{StaticResource H1}"
                       HorizontalTextAlignment="Center" Margin="0,28,0,0" />
                <Label Text="Votre position actuelle sera transmise immédiatement&#10;au service de sécurité du campus."
                       Style="{StaticResource Muted}" HorizontalTextAlignment="Center" Margin="0,8,0,0" />

                <Border Style="{StaticResource Card}" Padding="14,12" StrokeShape="RoundRectangle 14" Margin="0,26,0,0">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <controls:IconView Kind="pin" Size="22" IconColor="{StaticResource Blue}" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="Bloc B - Campus principal" FontSize="15" FontAttributes="Bold"
                               TextColor="{StaticResource Navy}" VerticalOptions="Center" />
                        <Border Grid.Column="2" Style="{StaticResource Pill}" BackgroundColor="{StaticResource GreenLight}"
                                Padding="12,6" VerticalOptions="Center">
                            <Label Text="PRÉCISE" Style="{StaticResource BadgeText}" TextColor="{StaticResource Green}" />
                        </Border>
                    </Grid>
                </Border>

                <Button Text="Envoyer l’alerte maintenant" BackgroundColor="{StaticResource Red}" TextColor="White"
                        FontSize="16" FontAttributes="Bold" CornerRadius="14" HeightRequest="50" Padding="0"
                        Margin="0,30,0,0" Clicked="OnSendClicked" />
                <Button Text="Annuler" Style="{StaticResource OutlineButton}" Margin="0,12,0,0" Clicked="OnCancelClicked" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
