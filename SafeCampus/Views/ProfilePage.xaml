<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="SafeCampus.Views.ProfilePage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:SafeCampus.Controls"
             Title="Profil">

    <Grid RowDefinitions="Auto,*,Auto">

        <controls:PageHeader Title="Profil" Subtitle="Gérez votre compte SafeCampus." Tag="Compte" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="22,22,22,20" Spacing="14">

                <Border WidthRequest="84" HeightRequest="84" BackgroundColor="{StaticResource Blue}"
                        StrokeThickness="0" StrokeShape="RoundRectangle 42" HorizontalOptions="Center">
                    <Label Text="N" FontSize="34" FontAttributes="Bold" TextColor="White"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <VerticalStackLayout Spacing="2">
                    <Label Text="Ntamacko Etudiant" FontSize="20" FontAttributes="Bold"
                           TextColor="{StaticResource Navy}" HorizontalTextAlignment="Center" />
                    <Label Text="Étudiant - Campus principal" FontSize="14"
                           TextColor="{StaticResource Slate}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <Border Style="{StaticResource Card}" StrokeShape="RoundRectangle 20" Padding="16,14" Margin="0,8,0,0">
                    <VerticalStackLayout Spacing="14">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                            <Border WidthRequest="40" HeightRequest="40" BackgroundColor="{StaticResource BlueLight}"
                                    StrokeThickness="0" StrokeShape="RoundRectangle 12" VerticalOptions="Center">
                                <controls:IconView Kind="mail" Size="20" IconColor="{StaticResource Blue}" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                <Label Text="E-mail universitaire" FontSize="12" TextColor="{StaticResource Slate}" />
                                <Label Text="etudiant@campus.cm" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource Navy}" />
                            </VerticalStackLayout>
                        </Grid>
                        <BoxView HeightRequest="1" Color="{StaticResource Line}" />
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                            <Border WidthRequest="40" HeightRequest="40" BackgroundColor="{StaticResource GreenLight}"
                                    StrokeThickness="0" StrokeShape="RoundRectangle 12" VerticalOptions="Center">
                                <controls:IconView Kind="phone" Size="20" IconColor="{StaticResource Green}" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                <Label Text="Téléphone" FontSize="12" TextColor="{StaticResource Slate}" />
                                <Label Text="+237 6XX XXX XXX" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource Navy}" />
                            </VerticalStackLayout>
                        </Grid>
                        <BoxView HeightRequest="1" Color="{StaticResource Line}" />
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                            <Border WidthRequest="40" HeightRequest="40" BackgroundColor="{StaticResource OrangeLight}"
                                    StrokeThickness="0" StrokeShape="RoundRectangle 12" VerticalOptions="Center">
                                <controls:IconView Kind="pin" Size="20" IconColor="{StaticResource Orange}" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                <Label Text="Localisation" FontSize="12" TextColor="{StaticResource Slate}" />
                                <Label Text="Activée" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource Green}" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource OutlineBtn}" Stroke="{StaticResource RedLine}"
                        BackgroundColor="{StaticResource RedLight}" Margin="0,8,0,0">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnLogoutTapped" />
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="10" HorizontalOptions="Center" VerticalOptions="Center">
                        <controls:IconView Kind="logout" Size="20" IconColor="{StaticResource Red}" />
                        <Label Text="Se déconnecter" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource Red}" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <controls:BottomNavBar Grid.Row="2" Active="profile" />
    </Grid>
</ContentPage>
