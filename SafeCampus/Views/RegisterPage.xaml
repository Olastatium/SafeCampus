<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="SafeCampus.Views.RegisterPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:SafeCampus.Controls"
             Title="Créer un compte">

    <Grid RowDefinitions="Auto,*">

        <controls:PageHeader Title="Créer un compte" ShowBack="True" ShowBell="False"
                             BackRoute="//login" Padding="0,10,0,14" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="22,4,22,24" Spacing="0">

                <Label Text="Rejoignez SafeCampus" Style="{StaticResource H2}" />
                <Label Text="Utilisez votre adresse e-mail universitaire." Style="{StaticResource Muted}" Margin="0,2,0,0" />

                <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,8,0,0">
                    <controls:InputField Caption="Prénom" Text="Ntamacko" />
                    <controls:InputField Grid.Column="1" Caption="Nom" Text="Etudiant" />
                </Grid>

                <controls:InputField Caption="E-mail universitaire" Text="etudiant@campus.cm"
                                     Keyboard="Email" Margin="0,12,0,0" />
                <controls:InputField Caption="Téléphone" Text="+237 6XX XXX XXX"
                                     Keyboard="Telephone" Margin="0,12,0,0" />
                <controls:InputField Caption="Mot de passe" Text="12345678"
                                     IsPassword="True" Margin="0,12,0,0" />

                <!-- Jauge de robustesse -->
                <Grid Margin="0,6,0,0" HeightRequest="5">
                    <BoxView Color="{StaticResource Line}" CornerRadius="3" />
                    <Grid ColumnDefinitions="66*,34*">
                        <BoxView Color="{StaticResource Green}" CornerRadius="3" />
                    </Grid>
                </Grid>
                <Label Text="Mot de passe sécurisé" FontSize="12" FontAttributes="Bold"
                       TextColor="{StaticResource Green}" Margin="0,6,0,0" />

                <controls:InputField Caption="Confirmation du mot de passe" Text="12345678"
                                     IsPassword="True" Margin="0,12,0,0" />

                <HorizontalStackLayout Spacing="2" Margin="0,8,0,0">
                    <CheckBox Color="{StaticResource CheckGrey}" VerticalOptions="Center" />
                    <Label Text="J’accepte les conditions d’utilisation." FontSize="14"
                           TextColor="{StaticResource SlateDark}" VerticalOptions="Center" />
                </HorizontalStackLayout>

                <Button Text="Créer mon compte" Style="{StaticResource PrimaryButton}"
                        Margin="0,22,0,0" Clicked="OnCreateClicked" />

                <HorizontalStackLayout Spacing="8" HorizontalOptions="Center" Margin="0,22,0,0">
                    <Label Text="Déjà inscrit ?" FontSize="14" TextColor="{StaticResource Slate}" />
                    <Label Text="Se connecter" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Blue}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnLoginTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
