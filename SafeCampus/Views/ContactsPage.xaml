<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="SafeCampus.Views.ContactsPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:SafeCampus.Controls"
             Title="Contacts de sécurité">

    <Grid RowDefinitions="Auto,*,Auto">

        <controls:PageHeader Title="Contacts de sécurité"
                             Subtitle="Contactez rapidement le service adapté."
                             Tag="Aide" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="22,18,22,20" Spacing="14">

                <Border Style="{StaticResource Card}" StrokeShape="RoundRectangle 20" Padding="14,16">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                        <Border WidthRequest="48" HeightRequest="48" BackgroundColor="{StaticResource RedLight}"
                                StrokeThickness="0" StrokeShape="RoundRectangle 16" VerticalOptions="Center">
                            <controls:IconView Kind="phone" Size="22" IconColor="{StaticResource Red}" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                            <Label Text="Sécurité du campus" FontSize="17" FontAttributes="Bold" TextColor="{StaticResource Navy}" />
                            <Label Text="Service sécurité" FontSize="13" TextColor="{StaticResource Slate}" />
                            <Label Text="+237 XXX XXX XXX" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource SlateDark}" />
                        </VerticalStackLayout>
                        <Border Grid.Column="2" Style="{StaticResource OutlineBtn}" HeightRequest="42" Padding="10,0" VerticalOptions="Center">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCallTapped" CommandParameter="Sécurité du campus" />
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center" HorizontalOptions="Center">
                                <controls:IconView Kind="phone" Size="18" IconColor="{StaticResource Navy}" />
                                <Label Text="Appeler" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource Navy}" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}" StrokeShape="RoundRectangle 20" Padding="14,16">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                        <Border WidthRequest="48" HeightRequest="48" BackgroundColor="{StaticResource GreenLight}"
                                StrokeThickness="0" StrokeShape="RoundRectangle 16" VerticalOptions="Center">
                            <controls:IconView Kind="phone" Size="22" IconColor="{StaticResource Green}" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                            <Label Text="Infirmerie" FontSize="17" FontAttributes="Bold" TextColor="{StaticResource Navy}" />
                            <Label Text="Premiers soins" FontSize="13" TextColor="{StaticResource Slate}" />
                            <Label Text="+237 XXX XXX XXX" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource SlateDark}" />
                        </VerticalStackLayout>
                        <Border Grid.Column="2" Style="{StaticResource OutlineBtn}" HeightRequest="42" Padding="10,0" VerticalOptions="Center">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCallTapped" CommandParameter="Infirmerie" />
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center" HorizontalOptions="Center">
                                <controls:IconView Kind="phone" Size="18" IconColor="{StaticResource Navy}" />
                                <Label Text="Appeler" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource Navy}" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}" StrokeShape="RoundRectangle 20" Padding="14,16">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                        <Border WidthRequest="48" HeightRequest="48" BackgroundColor="{StaticResource BlueLight}"
                                StrokeThickness="0" StrokeShape="RoundRectangle 16" VerticalOptions="Center">
                            <controls:IconView Kind="phone" Size="22" IconColor="{StaticResource Blue}" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                            <Label Text="Administration" FontSize="17" FontAttributes="Bold" TextColor="{StaticResource Navy}" />
                            <Label Text="Accueil / assistance" FontSize="13" TextColor="{StaticResource Slate}" />
                            <Label Text="+237 XXX XXX XXX" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource SlateDark}" />
                        </VerticalStackLayout>
                        <Border Grid.Column="2" Style="{StaticResource OutlineBtn}" HeightRequest="42" Padding="10,0" VerticalOptions="Center">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCallTapped" CommandParameter="Administration" />
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center" HorizontalOptions="Center">
                                <controls:IconView Kind="phone" Size="18" IconColor="{StaticResource Navy}" />
                                <Label Text="Appeler" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource Navy}" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}" StrokeShape="RoundRectangle 20" Padding="14,16">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                        <Border WidthRequest="48" HeightRequest="48" BackgroundColor="{StaticResource OrangeLight}"
                                StrokeThickness="0" StrokeShape="RoundRectangle 16" VerticalOptions="Center">
                            <controls:IconView Kind="phone" Size="22" IconColor="{StaticResource Orange}" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                            <Label Text="Responsable sécurité" FontSize="17" FontAttributes="Bold" TextColor="{StaticResource Navy}" />
                            <Label Text="Référent campus" FontSize="13" TextColor="{StaticResource Slate}" />
                            <Label Text="+237 XXX XXX XXX" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource SlateDark}" />
                        </VerticalStackLayout>
                        <Border Grid.Column="2" Style="{StaticResource OutlineBtn}" HeightRequest="42" Padding="10,0" VerticalOptions="Center">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCallTapped" CommandParameter="Responsable sécurité" />
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center" HorizontalOptions="Center">
                                <controls:IconView Kind="phone" Size="18" IconColor="{StaticResource Navy}" />
                                <Label Text="Appeler" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource Navy}" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>
                    </Grid>
                </Border>

                <!-- Appel d'urgence -->
                <Border BackgroundColor="{StaticResource RedLight}" Stroke="{StaticResource RedLine}" StrokeThickness="1.5"
                        StrokeShape="RoundRectangle 20" Padding="16,18" Margin="0,10,0,0">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <controls:IconView Kind="alert" Size="22" IconColor="{StaticResource Red}" VerticalOptions="Start" Margin="4,6,0,0" />
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4">
                            <Label Text="Appel d’urgence" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource Red}" />
                            <Label Text="Utilisez cette option uniquement en&#10;cas de danger immédiat." FontSize="13" TextColor="{StaticResource Slate}" />
                        </VerticalStackLayout>
                        <Border Grid.Column="2" BackgroundColor="{StaticResource Red}" StrokeThickness="0"
                                StrokeShape="RoundRectangle 18" Padding="14,0" HeightRequest="46" VerticalOptions="Center">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCallTapped" CommandParameter="Appel d’urgence" />
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center" HorizontalOptions="Center">
                                <controls:IconView Kind="phone" Size="18" IconColor="White" />
                                <Label Text="Appeler" FontSize="15" FontAttributes="Bold" TextColor="White" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>
                    </Grid>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <controls:BottomNavBar Grid.Row="2" Active="contacts" />
    </Grid>
</ContentPage>
