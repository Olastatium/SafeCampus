<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="SafeCampus.Views.ZonesPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:SafeCampus.Controls"
             Title="Zones du campus">

    <Grid RowDefinitions="Auto,*,Auto">

        <controls:PageHeader Title="Zones du campus"
                             Subtitle="Consultez le niveau de vigilance par zone."
                             Tag="Cartographie" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="18,16,18,20" Spacing="14">

                <controls:CampusMap Variant="zones" />

                <Label Text="Légende" FontSize="17" FontAttributes="Bold" TextColor="{StaticResource Navy}" Margin="4,4,0,0" />

                <HorizontalStackLayout Spacing="10" Margin="4,0,0,0">
                    <Border Style="{StaticResource Pill}" BackgroundColor="{StaticResource GreenLight}">
                        <Label Text="Zone sûre" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource Green}" />
                    </Border>
                    <Border Style="{StaticResource Pill}" BackgroundColor="{StaticResource OrangeLight}">
                        <Label Text="Sous vigilance" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource Orange}" />
                    </Border>
                    <Border Style="{StaticResource Pill}" BackgroundColor="{StaticResource RedLight}">
                        <Label Text="Zone à risque" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource Red}" />
                    </Border>
                </HorizontalStackLayout>

                <!-- Zone sélectionnée -->
                <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,6,0,0">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Spacing="4">
                            <Border Style="{StaticResource Badge}" BackgroundColor="{StaticResource OrangeLight}">
                                <Label Text="VIGILANCE" Style="{StaticResource BadgeText}" TextColor="{StaticResource Orange}" />
                            </Border>
                            <Label Text="Bloc B" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource Navy}" />
                            <Label Text="Plusieurs signalements récents ont été&#10;enregistrés dans cette zone."
                                   FontSize="14" TextColor="{StaticResource Slate}" />
                        </VerticalStackLayout>
                        <controls:IconView Grid.Column="1" Kind="chevron-right" Size="20"
                                           IconColor="{StaticResource Blue}" VerticalOptions="Start" Margin="0,10,0,0" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}" StrokeShape="RoundRectangle 14" HeightRequest="52">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnDetailsTapped" />
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="12" HorizontalOptions="Start" VerticalOptions="Center" Margin="18,0,0,0">
                        <controls:IconView Kind="info" Size="22" IconColor="{StaticResource Navy}" />
                        <Label Text="Voir les détails" FontSize="17" FontAttributes="Bold" TextColor="{StaticResource Navy}" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <controls:BottomNavBar Grid.Row="2" Active="map" />
    </Grid>
</ContentPage>
