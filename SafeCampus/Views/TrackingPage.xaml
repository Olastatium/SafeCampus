<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="SafeCampus.Views.TrackingPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:SafeCampus.Controls"
             Title="Suivi du signalement">

    <Grid RowDefinitions="Auto,*,Auto,Auto">

        <controls:PageHeader Title="Suivi du signalement"
                             Subtitle="Consultez l’état de votre incident."
                             Tag="Réf. SIG-2026-00124" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="22,18,22,12" Spacing="0">

                <!-- Résumé -->
                <Border Style="{StaticResource Card}" StrokeShape="RoundRectangle 20" Padding="16,14">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Spacing="4">
                            <Border Style="{StaticResource Badge}" BackgroundColor="{StaticResource BlueLight}">
                                <Label Text="EN COURS" Style="{StaticResource BadgeText}" TextColor="{StaticResource Blue}" />
                            </Border>
                            <Label Text="Vol" FontSize="22" FontAttributes="Bold" TextColor="{StaticResource Navy}" />
                            <Label Text="Bloc administratif - 05 octobre 2026" FontSize="14" TextColor="{StaticResource Slate}" />
                        </VerticalStackLayout>
                        <controls:IconView Grid.Column="1" Kind="clock" Size="26" IconColor="{StaticResource Blue}" VerticalOptions="Center" />
                    </Grid>
                </Border>

                <Label Text="Progression" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource Navy}" Margin="0,24,0,20" />

                <VerticalStackLayout Spacing="0" Margin="4,0,0,0">

                <Grid ColumnDefinitions="30,*" ColumnSpacing="14">
                    <VerticalStackLayout Spacing="0" HorizontalOptions="Center">
                        <Border WidthRequest="26" HeightRequest="26" BackgroundColor="{StaticResource Green}" StrokeThickness="0" StrokeShape="RoundRectangle 13">
                            <controls:IconView Kind="check" Size="16" IconColor="White" />
                        </Border>
                        <BoxView WidthRequest="3" HeightRequest="38" Color="{StaticResource Line}" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="2" Margin="0,1,0,0">
                        <Label Text="Signalement envoyé" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource Navy}" />
                        <Label Text="Votre demande a été créée." FontSize="13" TextColor="{StaticResource Slate}" />
                    </VerticalStackLayout>
                </Grid>

                <Grid ColumnDefinitions="30,*" ColumnSpacing="14">
                    <VerticalStackLayout Spacing="0" HorizontalOptions="Center">
                        <Border WidthRequest="26" HeightRequest="26" BackgroundColor="{StaticResource Green}" StrokeThickness="0" StrokeShape="RoundRectangle 13">
                            <controls:IconView Kind="check" Size="16" IconColor="White" />
                        </Border>
                        <BoxView WidthRequest="3" HeightRequest="38" Color="{StaticResource Line}" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="2" Margin="0,1,0,0">
                        <Label Text="Signalement reçu" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource Navy}" />
                        <Label Text="Le service sécurité a été notifié." FontSize="13" TextColor="{StaticResource Slate}" />
                    </VerticalStackLayout>
                </Grid>

                <Grid ColumnDefinitions="30,*" ColumnSpacing="14">
                    <VerticalStackLayout Spacing="0" HorizontalOptions="Center">
                        <Border WidthRequest="26" HeightRequest="26" BackgroundColor="{StaticResource Blue}" StrokeThickness="0" StrokeShape="RoundRectangle 13">
                            <BoxView WidthRequest="10" HeightRequest="10" CornerRadius="5" Color="White" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <BoxView WidthRequest="3" HeightRequest="38" Color="{StaticResource Line}" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="2" Margin="0,1,0,0">
                        <Label Text="En cours de traitement" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource Navy}" />
                        <Label Text="Vérification des informations." FontSize="13" TextColor="{StaticResource Slate}" />
                    </VerticalStackLayout>
                </Grid>

                <Grid ColumnDefinitions="30,*" ColumnSpacing="14">
                    <VerticalStackLayout Spacing="0" HorizontalOptions="Center">
                        <Border WidthRequest="26" HeightRequest="26" BackgroundColor="{StaticResource Line}" StrokeThickness="0" StrokeShape="RoundRectangle 13" />
                        <BoxView WidthRequest="3" HeightRequest="38" Color="{StaticResource Line}" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="2" Margin="0,1,0,0">
                        <Label Text="Intervention de la sécurité" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource Navy}" />
                        <Label Text="À venir" FontSize="13" TextColor="{StaticResource Slate}" />
                    </VerticalStackLayout>
                </Grid>

                <Grid ColumnDefinitions="30,*" ColumnSpacing="14">
                    <VerticalStackLayout Spacing="0" HorizontalOptions="Center">
                        <Border WidthRequest="26" HeightRequest="26" BackgroundColor="{StaticResource Line}" StrokeThickness="0" StrokeShape="RoundRectangle 13" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="2" Margin="0,1,0,0">
                        <Label Text="Signalement clôturé" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource Navy}" />
                        <Label Text="À venir" FontSize="13" TextColor="{StaticResource Slate}" />
                    </VerticalStackLayout>
                </Grid>

                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <VerticalStackLayout Grid.Row="2" Padding="22,0,22,12" Spacing="12">
            <BoxView HeightRequest="1.5" Color="{StaticResource Line}" />
            <Label Text="Dernière mise à jour : il y a 5 min" FontSize="12" TextColor="{StaticResource Slate}" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                <Border Style="{StaticResource OutlineBtn}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnDetailsTapped" />
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="8" HorizontalOptions="Center" VerticalOptions="Center">
                        <controls:IconView Kind="info" Size="20" IconColor="{StaticResource Navy}" />
                        <Label Text="Voir les détails" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource Navy}" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource FilledBtn}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnContactTapped" />
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="8" HorizontalOptions="Center" VerticalOptions="Center">
                        <controls:IconView Kind="phone" Size="20" IconColor="White" />
                        <Label Text="Contacter sécurité" FontSize="15" FontAttributes="Bold" TextColor="White" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>
            </Grid>
        </VerticalStackLayout>

        <controls:BottomNavBar Grid.Row="3" Active="tracking" />
    </Grid>
</ContentPage>
